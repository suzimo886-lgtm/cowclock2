
name: Build Android APK

on:
  workflow_dispatch:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout source
        uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Install Android platform
        run: sdkmanager 'platforms;android-35' 'build-tools;35.0.0'

      - name: Extract Android project
        run: |
          unzip -q cowclock-android-build.zip -d project
          find project -name settings.gradle -print

      - name: Build APK
        run: |
          cd project/牛马下班倒计时_安卓APP项目
          gradle --no-daemon assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: cow-offwork-debug-apk
          path: project/牛马下班倒计时_安卓APP项目/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
          retention-days: 14
